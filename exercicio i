//Faça um programa que receba um valor que é o valor pago, um segundo valor que é o preço do produto e retorne o troco a ser dado.

#include <iostream>
using namespace std;

int main(){
    
    float valorpago,valorproduto,troco;
    
    cout<<"Digite o valor a pagar: ";
    cin>>valorpago;
    
    cout<<"Digite o valor do produto: ";
    cin>>valorproduto;
    
    troco=valorpago-valorproduto;
    
    cout<<"Troco R$"<<troco;
    
    return 0;
}