//Faça um algoritmo para calcular quantas ferraduras são necessárias para equipar todos os cavalos comprados para um haras.

#include <iostream>
using namespace std;

int main(){
    
    int cavalo,equipar;
    
    cout<<"Digite a quantia de cavalos comprados: ";
    cin>>cavalo;
    
    equipar=cavalo*4;
    
    cout<<"Serão necessarias "<<equipar<<" ferraduras para equipar todos os cavalos.";
    
    return 0;
}